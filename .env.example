APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/ynab-splits-development.sqlite

# Runtime instance defaults. `pnpm dev:instance -- --id <slug>` overrides
# these values and writes disposable state below .local/instances/<slug>/.
INSTANCE_ID=default
INSTANCE_LABEL=
COOKIE_PREFIX=ynab_splits

# Production defaults. Development launchers replace both with their
# per-instance fake OAuth/API origin.
YNAB_API_ORIGIN=https://api.ynab.com/v1
YNAB_OAUTH_ORIGIN=https://app.ynab.com

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
# Generate with: openssl rand -hex 16 (exactly 32 bytes in this raw-key format)
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key
YNAB_CLIENT_ID=replace-with-ynab-client-id
YNAB_CLIENT_SECRET=replace-with-ynab-client-secret
HOST=0.0.0.0
PORT=3000
